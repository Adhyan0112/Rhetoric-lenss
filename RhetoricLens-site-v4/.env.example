# Copy this file to .env and fill in what you need. Never commit .env.

# "mock" = no key needed, scripted rehearsal only. "groq" = real LLM classifier.
LLM_PROVIDER=mock

# Required when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=6

# Required for live microphone -> Deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

# Tuning (optional)
CONFIDENCE_THRESHOLD=0.75
WINDOW_SECONDS=30
